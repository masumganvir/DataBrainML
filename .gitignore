.idea/
.agents/
*.swp
*.tsbuildinfo

# OS
.DS_Store
Thumbs.db

# Jupyter
.ipynb_checkpoints/
notebooks/.ipynb_checkpoints/

# Generated test datasets (large binaries, regenerate with script)
data/test_datasets/*.csv
data/test_datasets/*.xlsx

# ──────────────────────────────────────────────────────────────
# Runtime data (never commit — regenerated at runtime)
# ──────────────────────────────────────────────────────────────

# Uploaded datasets (user files — large, private)
datasets/
!datasets/.gitkeep

# Generated ML artifacts (models, reports, visualizations)
artifacts/*/
!artifacts/.gitkeep

# Backend artifacts
backend/artifacts/*/
!backend/artifacts/.gitkeep

# Trained model files
*.pkl
*.joblib
*.h5
*.pt
*.onnx
model_pipeline.pkl
models/

# MongoDB / local database files
*.bson
dump/

# Acceptance test temp outputs (generated by tests)
test_eda_system_acceptance.py

# Large notebook outputs
**/*.ipynb
